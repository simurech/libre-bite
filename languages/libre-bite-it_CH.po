msgstr "Nota: il vecchio parametro ?location=ID (senza prefisso) resta supportato per compatibilità."

#: templates/admin/help-partials/locations.php:208
msgid "Tip: Enable the \"Location Selection\" feature under Settings → Locations for the shortcode to be visible."
